class Solution {
public:
    vector<int> prevSmaller(vector<int>& arr) {
        vector<int> ans(arr.size(),-1);
        stack<int> st;

        for (int i=0;i<arr.size();i++) {

            while (!st.empty()&&arr[st.top()]>=arr[i]) {
                st.pop();
            }

            if (!st.empty()){
                ans[i]=arr[st.top()];
            }

            st.push(i);
        }

        return ans;
    }
};
