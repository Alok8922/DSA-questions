class Solution {
public:
    long long kthLargestLevelSum(TreeNode* root, int k) {
      vector<long long>ans;
      priority_queue<long long,vector<long long>,greater<long long>>pq;
      if(root==NULL)
      return -1;
      queue< TreeNode*>q;
      q.push(root);
      while(!q.empty()){
        int n=q.size();
        long long sum=0;
        while(n--){
            TreeNode* curr=q.front();
            q.pop();
            sum+=curr->val;
            if(curr->left)
            q.push(curr->left);
            if(curr->right)
            q.push(curr->right);
        }
        ans.push_back(sum);
      } 
      if(k>ans.size()){
        return -1;
      }
      for(long long i=0;i<ans.size();i++){
        pq.push(ans[i]);
        if(pq.size()>k){
            pq.pop();
        }
      }
      return pq.top();
     
    }
};
