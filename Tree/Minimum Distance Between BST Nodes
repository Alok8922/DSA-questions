lass Solution {
public:
void mindst(TreeNode* root,int &prev,int &ans){
    if (root==NULL)
    return;
    mindst(root->left,prev,ans);
    if(prev!=INT_MIN)
    ans=min(ans,root->val-prev);
    prev=root->val;
    mindst(root->right,prev,ans);

    }
    int minDiffInBST(TreeNode* root) {
        int prev=INT_MIN;
        int ans=INT_MAX;
        mindst(root,prev,ans);
        return ans;
    }
};
